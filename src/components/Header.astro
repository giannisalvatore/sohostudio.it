---
import logoBlack from "../assets/logo_black.svg";
import logoWhite from "../assets/logo_white.svg";

import Button from "../components/Button.astro";

const { light } = Astro.props;
---

<div class={`header ${light}`}>
    <div class="menu">
        <img src={logoWhite.src} alt="sohostudio logo black" />
        <div class="item">servizi</div>
        <div class="item"><a href="/portfolio">portfolio</a></div>
        <div class="item"><a href="/valori">valori</a></div>
        <div class="item"><a href="/team">chi siamo</a></div>
        <div class="item"><a href="/contatti">portfolio</a></div>
    </div>
    <Button text="Preventivo gratuito" />
</div>

<style>
    .header {
        padding: 25px 0;
        display: flex;
        justify-content: space-between;
    }
    button {
        background: #212121;
        border: 0;
        color: #fff;
        padding: 10px 17px;
    }
    .menu {
        display: flex;
        gap: 28px;
        align-items: center;

        font-size: 14px;

        font-weight: 700;
    }
    .dark {
        color: #fff;
    }
    .light {
        color: #111;
    }
    .item a {
        text-decoration: none;
        color: #fff;
    }
    .item {
        margin-top: 3px;
        opacity: 0.5;
        transition: 0.3s;
        cursor: pointer;
    }
    .item:hover,
    .item a:hover {
        opacity: 0.9;
    }
</style>
