---
import { SEO } from "astro-seo";
import seoData from "../data/seo.json";

const { pathname } = Astro.url;
const seo = seoData[pathname] || seoData.default;
---

<SEO
    title={seo.title}
    description={seo.description}
    openGraph={seo.openGraph}
    twitter={seo.twitter}
    extend={seo.extend}
/>

<script defer src="https://cloud.umami.is/script.js" data-website-id="5e01e77f-0100-4bbf-937e-8d88431a0712"></script>
