---
const { type } = Astro.props;
import "@/styles/globals.css";

import SeoManager from "@/components/SeoManager.astro";
import Schema from "@/components/Schema.astro";
---

<!doctype html>
<html lang="it">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <meta name="generator" content={Astro.generator} />
        
        <!-- Preload critical fonts -->
        <link rel="preload" href="/src/assets/fonts/Satoshi/Satoshi-Medium.woff2" as="font" type="font/woff2" crossorigin />
        
        <!-- Google Fonts ottimizzato con display=swap -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
        <noscript>
            <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&display=swap" rel="stylesheet" />
        </noscript>
        
        <SeoManager />
        <Schema />
    </head>
    <body class={type}>
        <div class="layout">
            <slot />
        </div>
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
    }
    @font-face {
        font-family: "Satoshi";
        src: url("/src/assets/fonts/Satoshi/Satoshi-Bold.woff2") format("woff2");
        font-weight: 700;
        font-style: normal;
    }
    @font-face {
        font-family: "Satoshi";
        src: url("/src/assets/fonts/Satoshi/Satoshi-Medium.woff2")
            format("woff2");
        font-weight: 400;
        font-style: normal;
    }
    @font-face {
        font-family: "Satoshi";
        src: url("/src/assets/fonts/Satoshi/Satoshi-Regular.woff2")
            format("woff2");
        font-weight: 300;
        font-style: normal;
    }
    body {
        font-family: "Satoshi", sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }
    * {
        font-family: "Satoshi", sans-serif;
    }
    .dark {
        background: #111;
        color: #fff;
    }
    .light {
        background: #fff;
        color: #111;
    }
</style>
