---
import { Image } from "astro:assets";

import logoBlack from "../assets/logo_black.svg";
import logoWhite from "../assets/logo_white.svg";

import NavigationMenu from "./NavigationMenu.jsx";
import Button from "../components/Button.astro";

const { type, btnText } = Astro.props;
const sub = [
    {
        title: "Branding, Creatività & Design",
        href: "/servizi/creativita-branding-design",
        description:
            "Creiamo identità visive uniche e soluzioni creative su misura.",
    },
    {
        title: "Software su misura",
        href: "/servizi/software-su-misura",
        description:
            "Sviluppiamo software personalizzati per soddisfare le esigenze specifiche.",
    },
    {
        title: "Intelligenza artificiale",
        href: "/servizi/intelligenza-artificiale",
        description:
            "Integriamo l'intelligenza artificiale per ottimizzare processi e operazioni.",
    },
    {
        title: "Siti web & E-commerce",
        href: "/servizi/siti-web-e-commerce",
        description:
            "Progettiamo siti web ed e-commerce facili da usare e scalabili.",
    },
    {
        title: "Landing page",
        href: "/servizi/landing-page",
        description:
            "Realizziamo landing page ottimizzate per conversioni elevate.",
    },
    {
        title: "Marketing",
        href: "/servizi/marketing",
        description:
            "Strategie di marketing digitale per incrementare visibilità e engagement.",
    },
];
---

<div class={`header ${type}`}>
    <div class="inner">
        <a href="/">
            <Image
                src={type == "dark" ? logoWhite : logoBlack}
                alt="sohostudio logo black"
                class="logo"
            />
        </a>
        <div class="menu">
            <div class="item">
                <NavigationMenu item={"servizi"} sub={sub} client:load />
            </div>
            <div class="item"><a href="/portfolio">portfolio</a></div>
            <hr />
            <div class="item"><a href="/mission">valori</a></div>
            <div class="item"><a href="/team">chi siamo</a></div>
            <div class="item"><a href="/contatti">contatti</a></div>
        </div>
        {btnText && <Button>{btnText}</Button>}
    </div>
</div>

<style>
    hr {
        opacity: 0.3;
    }
    .logo {
        margin-top: 6px;
        max-width: 110px;
    }
    .inner {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .header {
        padding: 25px 0;

        position: sticky;
        top: 0;
    }
    .header.dark {
        background: linear-gradient(180deg, #000, transparent);
    }
    .header.light {
        background: linear-gradient(180deg, #fff, transparent);
    }
    button {
        background: #212121;
        border: 0;
        color: #fff;
        padding: 10px 17px;
    }
    .menu {
        display: flex;
        gap: 28px;
        align-items: center;

        font-size: 14px;

        font-weight: 700;
    }
    .dark {
        color: #fff;
    }
    .light {
        color: #111;
    }
    a {
        text-decoration: none;
    }
    .dark .item a {
        color: #fff;
        cursor: pointer;
    }
    .light .item a {
        color: #111;
    }
    .item {
        margin-top: 3px;
        opacity: 0.5;
        transition: 0.3s;
        cursor: pointer;
    }
    .item:hover,
    .item a:hover {
        opacity: 0.9;
    }
    .bg-popover {
        background: #111;
        opacity: 1;
    }
</style>
