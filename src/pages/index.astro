---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import HeroImg from "../assets/hero/home.png";
import Logos from "../components/Logos.astro";
import Button from "../components/Button.astro";

import "@/styles/globals.css";
---

<Layout>
    <Header type="dark" btnText="Chiedi un preventivo" />
    <div class="hero">
        <h1>Trasformiamo idee in esperienze che fanno la differenza</h1>
        <p class="subtitle">
            Diamo vita a soluzioni su misura per il tuo business: dalla
            tecnologia che semplifica all'estetica che fa la differenza.
        </p>
        <Button size="l">Richiedi un preventivo gratuito</Button>
        <Image src={HeroImg} alt="A sphere of sohostudio." />
    </div>
    <Logos />
</Layout>

<style>
    body {
        background: #111;
    }
    h1 {
        font-family: "EB Garamond", serif;
        font-optical-sizing: auto;
        font-weight: <weight>;
        font-style: normal;
        color: #fff;
        font-weight: 300;
        font-size: 70px;
        max-width: 670px;
        line-height: 70px;
        padding-top: 70px;
        margin-bottom: 30px;
    }
    .subtitle {
        color: #fff;
        opacity: 0.6;
        max-width: 420px;
        font-size: 20px;
        line-height: 30px;
        margin-bottom: 40px;
    }
    .hero img {
        position: absolute;
        top: 0;
        right: 0;
        z-index: -1;
        opacity: 0.7;
    }
</style>
