---
import { Image } from "astro:assets";
import Doppelganger from "../assets/logos/doppel.png";
import Makerfaire from "../assets/logos/maker.png";
import Hoppipolla from "../assets/logos/hoppipolla.png";
import Sello from "../assets/logos/sello.png";
import Shampora from "../assets/logos/shampora.png";
import Sisal from "../assets/logos/sisal.png";
---

<div class="logos">
    <div class="list">
        <div>
            <Image src={Sisal} alt="Sisal logo" />
        </div>
        <div>
            <Image src={Doppelganger} alt="Doppelganger logo" />
        </div>
        <div>
            <Image src={Makerfaire} alt="Makerfaire logo" />
        </div>
        <div>
            <Image class="nomobile" src={Hoppipolla} alt="Hoppipolla logo" />
        </div>
        <div>
            <Image class="nomobile" src={Sello} alt="Sello logo" />
        </div>
    </div>
</div>

<style>
    .logos {
        margin-top: 120px;
        padding-bottom: 90px;
    }
    .logos .list {
        display: flex;
        align-items: center;
        gap: 20px;
        justify-content: space-between;
    }
    .logos img {
        max-width: 140px;
        max-height: 32px;
        height: auto;
        width: auto;
    }
    @media screen and (max-width: 880px) {
        .nomobile {
            display: none;
        }
        .logos img {
            max-width: 100%;
        }
        .logos {
            margin-top: 60px;
            padding-bottom: 30px;
        }
    }
</style>
