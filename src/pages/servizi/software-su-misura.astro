---
import Page from "../../layouts/Page.astro";
import Layout from "../../layouts/Layout.astro";

import { Image } from "astro:assets";
import HeroImg from "../../assets/hero/branding.png";
---

<Layout type="dark">
    <Page
        btnText="Parla con un developer"
        topTitle="Software su misura"
        title="Automatizza i processi della tua azienda"
        type="dark"
        subTitle="Creiamo applicazioni per soddisfare le esigenze specifiche della tua azienda. Dal concept allo sviluppo, offriamo soluzioni per ottimizzare il tuo business."
    />
</Layout>

<style>
    .grad {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translate(-50%);
        z-index: -1;
        opacity: 0.7;
    }
</style>
