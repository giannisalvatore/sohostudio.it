---
import { Image } from "astro:assets";

import Layout from "../layouts/Layout.astro";

import HeroImg from "../assets/hero/home.png";

import Header from "../components/Header.astro";
import Logos from "../components/Logos.astro";
import Button from "../components/Button.astro";
import Footer from "../components/Footer.astro";

import Shampora from "../assets/portfolio/shampora.jpg";
import Podernuovo from "../assets/portfolio/podernuovo.jpg";
import Hoppipolla from "../assets/portfolio/hoppipolla.jpeg";
import Paros from "../assets/portfolio/paros.jpg";
import Copihue from "../assets/portfolio/copihue.jpg";
import Wave from "../assets/portfolio/wave.jpg";
import Hyperlens from "../assets/portfolio/hyperlens.jpg";
import Attivita24 from "../assets/portfolio/attivita24.jpg";
import Giuliana from "../assets/portfolio/giuliana.jpg";

const portfolio = [
    {
        title: "Attivita24",
        description: "Proprietary Platform",
        photo: Attivita24,
        alt: "Attivita24 project",
    },
    {
        title: "Podernuovo by Giovanni Bulgari",
        description: "Art Direction · Photography",
        photo: Podernuovo,
        alt: "",
    },
    {
        title: "hoppípolla",
        description: "Graphic Design · Photography",
        photo: Hoppipolla,
        alt: "",
    },
    {
        title: "Hyperlens",
        description: "Website · Backend · Marketing",
        photo: Hyperlens,
        alt: "",
    },
    {
        title: "Paros Architecture",
        description: "Photography",
        photo: Paros,
        alt: "",
    },
    {
        title: "Copihue Floral Studio",
        description: "Art Direction · Photography · Video",
        photo: Copihue,
        alt: "",
    },
    {
        title: "Wave Market",
        description: "Graphic Design · Photography",
        photo: Wave,
        alt: "",
    },
    {
        title: "Giuliana Nardi",
        description: "Photography",
        photo: Giuliana,
        alt: "",
    },
];

const chunkArray = (arr: any[], size: number) => {
    return Array.from({ length: Math.ceil(arr.length / size) }, (_, i) =>
        arr.slice(i * size, i * size + size)
    );
};

const chunkedPortfolio = chunkArray(portfolio, 3);
const chunkedPortfolioMobile = chunkArray(portfolio, 1);
---

<Layout>
    <Header type="dark" btnText="Chiedi un preventivo" />
    <div class="container">
        <div class="black">
            <div class="hero">
                <h1>
                    I brand non sono più solo prodotti: sono esperienze,
                    connessioni, emozioni. <br /><br />
                    Creiamo soluzioni che trasformano le
                    idee in realtà, unendo innovazione e visione per far
                    crescere il tuo business come mai prima d'ora.
                </h1>
                <div class="intro-content">
                    <p>
                        Siamo un'<strong>agenzia digitale</strong> con sede a <strong>Roma</strong> specializzata nello sviluppo di progetti digitali innovativi. 
                        Dalla consulenza strategica alla realizzazione tecnica, supportiamo aziende e startup nel creare esperienze digitali che generano risultati concreti.
                    </p>
                    <p>
                        Dal <strong>design di siti web</strong> allo <strong>sviluppo di applicazioni mobile</strong>, dalla <strong>creazione 
                        di identità visive memorabili</strong> alle <strong>strategie di marketing digitale data-driven</strong>, ogni servizio è progettato 
                        per portare il tuo brand al livello successivo. 
                    </p>
                    <p>
                        Uniamo creatività e tecnologia per trasformare la tua visione in realtà digitale.
                    </p>
                </div>
            </div>
            <Logos />
            <div class="portfolio desktop">
                {
                    chunkedPortfolio.map((group: any) => (
                        <div class="row">
                            {group.map((p: any, index: number) => (
                                <div class="item">
                                    <p class="title">{p.title}</p>
                                    <Image src={p.photo} alt={p.alt || p.title} loading="lazy" />
                                    <p class="description">{p.description}</p>
                                </div>
                            ))}
                        </div>
                    ))
                }
            </div>
            <div class="portfolio mobile">
                {
                    chunkedPortfolioMobile.map((group: any) => (
                        <div class="row">
                            {group.map((p: any, index: number) => (
                                <div class="item">
                                    <p class="title">{p.title}</p>
                                    <Image src={p.photo} alt={p.alt || p.title} loading="lazy" />
                                    <p class="description">{p.description}</p>
                                </div>
                            ))}
                        </div>
                    ))
                }
            </div>
            <Footer type="dark" />
        </div>
    </div>
</Layout>

<style>
    @media screen and (max-width: 880px) {
        .container {
            padding-left: 20px;
            padding-right: 20px;
        }
        .hero h1 {
            font-size: 32px;
            line-height: 38px;
            padding-top: 50px;
        }
        .intro-content {
            margin-top: 30px;
            margin-bottom: 40px;
        }
        .intro-content p {
            display: none;
        }
        .bigTitle {
            font-size: 24px;
            line-height: 28px;
            margin-top: 20px;
        }
        .subBigTitle {
            font-size: 16px;
            margin-top: 20px;
            margin-bottom: 50px;
        }
        .title {
            font-size: 18px;
        }
        .description {
            font-size: 12px;
            margin-top: 10px;
        }
        .mobile {
            display: block;
        }
        .desktop {
            display: none;
        }
        .hero{
            padding: 0;
        }
    }
</style>

<style>
    .mobile {
        display: none;
    }
    .desktop {
        display: block;
    }

    .container {
        max-width: 1300px;
        padding-left: 50px;
        padding-right: 50px;
        margin: 0 auto;
    }
    body {
        background: #111;
    }
    .bigTitle {
        font-size: 45px;
        line-height: 48px;
        text-align: center;
        font-family: "EB Garamond";
        opacity: 0.8;
        max-width: 600px;

        color: #fff;
        font-family: "EB Garamond", serif;
        margin: 0 auto;
        text-align: center;
        margin-top: 30px;
        opacity: 0.8;
    }
    .subBigTitle {
        font-size: 20px;
        text-align: center;
        margin: 0 auto;
        color: #fff;
        opacity: 0.6;
        max-width: 600px;
        font-weight: 400;
        margin-top: 30px;
        margin-bottom: 100px;
    }
    h1 {
        font-family: "EB Garamond", serif;
        font-optical-sizing: auto;
        font-style: normal;
        color: #fff;
        font-weight: 300;
        font-size: 60px;
        max-width: 900px;
        line-height: 59px;
        margin-bottom: 20px;
    }
    .intro-content {
        max-width: 900px;
    }
    .intro-content p {
        color: #fff;
        opacity: 0.8;
        font-size: 17px;
        line-height: 28px;
        margin-bottom: 20px;
        font-weight: 300;
    }
    .intro-content strong {
        opacity: 1;
        font-weight: 500;
    }
    h1 * {
        display: inline-block;
    }
    h1 svg {
        line-height: 2px;
    }
    .subtitle {
        color: #fff;
        opacity: 0.6;
        max-width: 340px;
        font-size: 18px;
        line-height: 30px;
        margin-bottom: 40px;
    }
    .hero img {
        position: absolute;
        top: 0;
        right: 0;
        z-index: -1;
        opacity: 0.2;
    }
    .portfolio {
        margin-top: 50px;
    }
    .portfolio img {
        max-width: 100%;
        border-radius: 10px;
    }
    .row {
        display: flex;
        gap: 20px;
        margin-bottom: 30px;
    }
    .title {
        color: #fff;
        font-family: "EB Garamond";
        font-size: 22px;
        margin-bottom: 10px;
    }
    .description {
        color: #fff;
        opacity: 0.7;
        font-weight: 300;
        font-size: 14px;
        margin-top: 15px;
    }
    .item {
        flex: 1;
    }
    .item .title {
        margin-top: 10px;
    }
    .portoflio hr {
        margin-bottom: 20px;
        border-color: red;
    }
    .hero{
        display: flex;
        gap: 50px;
        padding-top: 70px;
    }
</style>
