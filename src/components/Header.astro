---
import { Image } from "astro:assets";

import logoBlack from "../assets/logo_black.svg";
import logoWhite from "../assets/logo_white.svg";

import NavigationMenu from "./NavigationMenu.jsx";
import Button from "../components/Button.astro";

import Grad01 from "../assets/categoryLogos/Grad_01.png";
import Grad02 from "../assets/categoryLogos/Grad_02.png";
import Grad03 from "../assets/categoryLogos/Grad_03.png";
import Grad04 from "../assets/categoryLogos/Grad_04.png";
import Grad05 from "../assets/categoryLogos/Grad_05.png";
import Grad06 from "../assets/categoryLogos/Grad_06.png";

const { type, btnText } = Astro.props;
const sub = [
    {
        title: "Branding, Creatività & Design",
        href: "/servizi/creativita-branding-design",
        description:
            "Creiamo identità visive uniche e soluzioni creative su misura.",
        logo: Grad01,
    },
    {
        title: "Software su misura",
        href: "/servizi/software-su-misura",
        description:
            "Sviluppiamo software personalizzati per soddisfare le esigenze specifiche.",
        logo: Grad02,
    },
    {
        title: "Intelligenza artificiale",
        href: "/servizi/intelligenza-artificiale",
        description:
            "Integriamo l'intelligenza artificiale per ottimizzare processi e operazioni.",
        logo: Grad03,
    },
    {
        title: "Siti web & E-commerce",
        href: "/servizi/siti-web-e-commerce",
        description:
            "Progettiamo siti web ed e-commerce facili da usare e scalabili.",
        logo: Grad04,
    },
    {
        title: "Applicazioni Mobile",
        href: "/servizi/applicazioni-mobile",
        description:
            "Realizziamo applicazioni mobile ottimizzate per il tuo business.",
        logo: Grad05,
    },
    {
        title: "Marketing",
        href: "/servizi/marketing",
        description:
            "Strategie di marketing digitale per incrementare visibilità e engagement.",
        logo: Grad06,
    },
];
---

<div class={`header ${type}`}>
    <div class="inner">
        <div class="first">
            <a href="/">
                <Image
                    src={type == "dark" ? logoWhite : logoBlack}
                    alt="sohostudio logo black"
                    class="logo"
                />
            </a>
        </div>
        <div class="menu">
            <div class="item">
                <NavigationMenu
                    type={type}
                    item={"Servizi"}
                    sub={sub}
                    client:load
                />
            </div>
            <div class="item"><a href="/portfolio">Portfolio</a></div>
            <hr />
            <div class="item"><a href="/mission">Valori</a></div>
            <div class="item"><a href="/team">Chi siamo</a></div>
            <div class="item"><a href="/contatti">Contatti</a></div>
        </div>
        <div class="last">
            {
                btnText ? (
                    <Button>{btnText}</Button>
                ) : (
                    <Button>Richiedi un preventivo</Button>
                )
            }
        </div>
    </div>
</div>

<style>
    hr {
        opacity: 0.3;
    }
    .first {
        flex: 1;
    }
    .menu {
        flex: 2;
        justify-content: center;
    }
    .last {
        flex: 1;
        text-align: right;
    }
    .logo {
        margin-top: 6px;
        max-width: 110px;
    }
    .inner {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .header {
        padding: 25px 0;

        position: sticky;
        top: 0;
        z-index: 9;
    }
    .header.dark {
        background: linear-gradient(180deg, #000, transparent);
    }
    .header.light {
        background: linear-gradient(180deg, #fff, transparent);
    }
    button {
        background: #212121;
        border: 0;
        color: #fff;
        padding: 10px 17px;
    }
    .menu {
        display: flex;
        gap: 28px;
        align-items: center;

        font-size: 14px;

        font-weight: 700;
    }
    .dark {
        color: #fff;
    }
    .light {
        color: #111;
    }
    a {
        text-decoration: none;
    }
    .dark .item a {
        color: #fff;
        cursor: pointer;
    }
    .light .item a {
        color: #111;
    }
    .item {
        margin-top: 3px;
        opacity: 0.5;
        transition: 0.3s;
        cursor: pointer;
    }
    .item:hover,
    .item a:hover {
        opacity: 1;
    }
    .bg-popover {
        background: #111;
        opacity: 1;
    }
</style>
