---
import Page from "../../layouts/Page.astro";
import Layout from "../../layouts/Layout.astro";

import { Image } from "astro:assets";
import HeroImg from "../../assets/pages/e-commerce/hero.jpg";
---

<Layout type="light">
    <Image
        src={HeroImg}
        alt="A sphere of sohostudio."
        alt="Grad"
        class="grad"
    />
    <Page
        btnText="Parla con un nostro store expert"
        topTitle="Siti web & E-commerce"
        title="Dai vita alla tua presenza online"
        type="light"
        subTitle="Creiamo soluzioni web personalizzate per ottimizzare l'esperienza utente e far crescere il tuo business."
    />
</Layout>

<style>
    .grad {
        position: absolute;
        top: 0;
        right: 0;
        z-index: -1;
        opacity: 0.8;
        max-width: 600px;
    }
</style>
