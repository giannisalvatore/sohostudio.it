---
import Page from "../layouts/Page.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout type="light">
    <Page
        topTitle="Contattaci o prenota una chiamata gratuita"
        title="Contattaci"
        type="light"
        subTitle="Puoi compilare il nostro form o prenotare una chiamata gratuita: ti chiameremo il giorno e all'orario che desideri"
    >
        <div class="contact-form">
            <form action="/thank-you" method="POST" netlify>
                <div class="form-group">
                    <label for="name">Nome</label>
                    <input type="text" id="name" name="name" required />
                </div>
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" required />
                </div>
                <div class="form-group">
                    <label for="message">Messaggio</label>
                    <textarea id="message" name="message" rows="5" required></textarea>
                </div>
                <button type="submit" class="btn-submit">Invia Messaggio</button>
            </form>
        </div>
        <div class="contact-info">
            <h3>Informazioni di Contatto</h3>
            <p>Email: hello@sohostudio.it</p>
        </div>
    </Page>
</Layout>

<style>
    .contact-form {
        max-width: 600px;
        margin: 40px auto;
        background: #fff;
        padding: 40px;
        border-radius: 12px;
    }
    .form-group {
        margin-bottom: 25px;
    }
    label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        font-size: 1rem;
    }
    input, textarea {
        width: 100%;
        padding: 15px;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 1rem;
        transition: border-color 0.3s ease;
    }
    input:focus, textarea:focus {
        outline: none;
        border-color: #000;
    }
    .btn-submit {
        background: #000;
        color: #fff;
        padding: 15px 30px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-size: 1rem;
        font-weight: 600;
        transition: background 0.3s ease;
    }
    .btn-submit:hover {
        background: #333;
    }
    .contact-info {
        text-align: center;
        margin-top: 60px;
    }
    .contact-info h3 {
        margin-bottom: 20px;
        font-size: 1.5rem;
    }
    .contact-info p {
        margin: 10px 0;
        color: #666;
        font-size: 1rem;
    }
</style>
