---
import { Image } from "astro:assets";

import logoBlack from "../assets/logo_black.svg";
import logoWhite from "../assets/logo_white.svg";

import Button from "../components/Button.astro";

const { type, btnText } = Astro.props;
---

<div class={`header ${type}`}>
    <div class="menu">
        <a href="/"
            ><Image
                src={type == "dark" ? logoWhite : logoBlack}
                alt="sohostudio logo black"
            /></a
        >
        <div class="item">servizi</div>
        <div class="item"><a href="/portfolio">portfolio</a></div>
        <div class="item"><a href="/mission">valori</a></div>
        <div class="item"><a href="/team">chi siamo</a></div>
        <div class="item"><a href="/contatti">contatti</a></div>
    </div>
    {btnText && <Button text={btnText} />}
</div>

<style>
    .header {
        padding: 25px 0;
        display: flex;
        justify-content: space-between;
    }
    button {
        background: #212121;
        border: 0;
        color: #fff;
        padding: 10px 17px;
    }
    .menu {
        display: flex;
        gap: 28px;
        align-items: center;

        font-size: 14px;

        font-weight: 700;
    }
    .dark {
        color: #fff;
    }
    .light {
        color: #111;
    }
    a {
        text-decoration: none;
    }
    .dark .item a {
        color: #fff;
    }
    .light .item a {
        color: #111;
    }
    .item {
        margin-top: 3px;
        opacity: 0.5;
        transition: 0.3s;
        cursor: pointer;
    }
    .item:hover,
    .item a:hover {
        opacity: 0.9;
    }
</style>
