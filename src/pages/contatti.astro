---
import Page from "../layouts/Page.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout type="light">
    <Page
        topTitle="Contattaci per il tuo progetto"
        title="Contattaci"
        type="light"
        subTitle="Scrivici e ti risponderemo il prima possibile"
    >
        <div class="contact-info">
            <div class="email-container">
                <a href="mailto:hello@sohostudio.it" class="email-link">
                    hello@sohostudio.it
                </a>
            </div>
            <p class="email-subtitle">Clicca per inviare una mail</p>
        </div>
    </Page>
</Layout>

<style>
    .contact-info {
        text-align: center;
        margin: 80px auto;
        max-width: 900px;
        padding: 60px 20px;
    }
    
    .email-container {
        margin-bottom: 20px;
    }
    
    .email-link {
        font-family: "EB Garamond", serif;
        font-size: 3.5rem;
        font-weight: 500;
        color: #111;
        text-decoration: none;
        display: inline-block;
        position: relative;
        transition: all 0.3s ease;
        line-height: 1.2;
    }
    
    .email-link:hover {
        color: #666;
        transform: translateY(-2px);
    }
    
    .email-link::after {
        content: '';
        position: absolute;
        bottom: -5px;
        left: 0;
        width: 100%;
        height: 2px;
        background: #111;
        transform: scaleX(0);
        transition: transform 0.3s ease;
    }
    
    .email-link:hover::after {
        transform: scaleX(1);
    }
    
    .email-subtitle {
        font-size: 1.1rem;
        color: #666;
        margin-top: 15px;
        font-weight: 300;
    }
    
    @media screen and (max-width: 768px) {
        .contact-info {
            margin: 40px auto;
            padding: 40px 20px;
        }
        
        .email-link {
            font-size: 2rem;
            word-break: break-all;
        }
        
        .email-subtitle {
            font-size: 1rem;
        }
    }
    
    @media screen and (max-width: 480px) {
        .email-link {
            font-size: 1.5rem;
        }
    }
</style>
