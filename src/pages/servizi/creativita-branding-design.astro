---
import Page from "../../layouts/Page.astro";
import Layout from "../../layouts/Layout.astro";

import { Image } from "astro:assets";
import HeroImg from "../../assets/hero/branding.png";
---

<Layout>
    <Page
        type="light"
        btnText="Parla con un designer"
        topTitle="Branding, Creatività & Design"
        title="Curiamo il tuo brand dalla A alla Z"
        ,
        subTitle="Siamo esperti nel creare brand che si distinguono. Dal logo alla tua comunicazione visiva, realizziamo soluzioni su misura per farti emergere."
    />
    <Image
        src={HeroImg}
        alt="A sphere of sohostudio."
        alt="Grad"
        class="grad"
    />
</Layout>

<style>
    .grad {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translate(-50%);
        z-index: -1;
        opacity: 0.7;
    }
</style>
