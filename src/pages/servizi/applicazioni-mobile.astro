---
import Page from "../../layouts/Page.astro";
import Layout from "../../layouts/Layout.astro";

import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import HeroImg from "../../assets/pages/applicazioni/hero.jpg";

import Triangle from "../../assets/pages/software-su-misura/triangolo.png";
import Square from "../../assets/pages/software-su-misura/rettangolo.png";
import Circle from "../../assets/pages/software-su-misura/cerchio.png";

import Arrow from "../../assets/icons/arrow.svg";
---

<Layout type="light">
    <Image src={HeroImg} alt="Marketing meeting" class="grad" />

    <Page
        btnText="Parla con un developer"
        topTitle="Applicazioni Mobile"
        title="App mobile che conquistano gli utenti"
        type="light"
        subTitle="Sviluppiamo app native e ibride per iOS e Android, con design intuitivo e performance eccezionali per far crescere il tuo business."
    >
        <div class="banner">
            <h2>Perché scegliere un'app mobile per il tuo business?</h2>
            <div class="keys">
                <div class="key">
                    <Image src={Triangle} alt="Engagement" />
                    <h3>+50% engagement utenti</h3>
                    <p>
                        Le app mobile aumentano l'interazione con i clienti,
                        offrendo esperienze personalizzate e notifiche push.
                    </p>
                </div>
                <div class="key">
                    <Image src={Square} alt="Revenue" />
                    <h3>+25% ricavi da mobile</h3>
                    <p>
                        Monetizza la tua app con acquisti in-app, abbonamenti
                        o pubblicità, aumentando i ricavi complessivi.
                    </p>
                </div>
                <div class="key">
                    <Image src={Circle} alt="Loyalty" />
                    <h3>Fidelizzazione clienti</h3>
                    <p>
                        Crea legami duraturi con i tuoi utenti attraverso
                        funzionalità esclusive e programmi di loyalty.
                    </p>
                </div>
            </div>
        </div>

        <h2>Cosa possiamo fare per te</h2>

        <div class="build">
            <div class="row">
                <div class="box">
                    <Icon name="mdi:cellphone" class="icon" />
                    <h3>Sviluppo App Native</h3>
                    <p>
                        Creiamo app native per iOS e Android utilizzando
                        Swift/Objective-C e Kotlin/Java per prestazioni ottimali.
                    </p>
                </div>
                <div class="box">
                    <Icon name="mdi:react" class="icon" />
                    <h3>App Ibride con React Native</h3>
                    <p>
                        Sviluppiamo app ibride cross-platform che funzionano
                        su entrambi i sistemi operativi con un singolo codebase.
                    </p>
                </div>
                <div class="box">
                    <Icon name="mdi:palette" class="icon" />
                    <h3>UI/UX Design</h3>
                    <p>
                        Progettiamo interfacce intuitive e user-friendly che
                        garantiscono un'esperienza utente eccezionale.
                    </p>
                </div>
            </div>
            <div class="row">
                <div class="box">
                    <Icon name="mdi:cloud" class="icon" />
                    <h3>Integrazione Backend</h3>
                    <p>
                        Connettiamo la tua app a servizi cloud e API per
                        sincronizzazione dati e funzionalità avanzate.
                    </p>
                </div>
                <div class="box">
                    <Icon name="mdi:test-tube" class="icon" />
                    <h3>Testing e QA</h3>
                    <p>
                        Effettuiamo test rigorosi per garantire stabilità,
                        sicurezza e compatibilità su tutti i dispositivi.
                    </p>
                </div>
                <div class="box">
                    <Icon name="mdi:rocket" class="icon" />
                    <h3>Pubblicazione sugli Store</h3>
                    <p>
                        Gestiamo il processo di pubblicazione su App Store e
                        Google Play, ottimizzando per massima visibilità.
                    </p>
                </div>
            </div>
        </div>
    </Page>
</Layout>

<style>
    .grad {
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;
        opacity: 0.6;
        max-width: 800px;
    }
    .banner {
        margin-top: 40px;
    }
    h2 {
        font-size: 45px;
        line-height: 48px;
        text-align: center;
        font-family: "EB Garamond";
        opacity: 0.8;
    }
    .key img {
        max-width: 48px;
        margin: 0 auto;
        margin-bottom: 15px;
    }
    .keys {
        display: flex;
        justify-content: center;
        align-items: flex-start;

        max-width: 800px;

        margin: 0 auto;

        margin-top: 60px;
        margin-bottom: 140px;
        gap: 20px;
    }
    .key h3 {
        font-weight: 700;
        margin-bottom: 10px;
    }
    .key p {
        text-align: center;

        max-width: 350px;
        margin: 0 auto;

        opacity: 0.7;
    }
    .key {
        flex: 1;
    }
    .row {
        display: flex;
        gap: 20px;
        margin-bottom: 20px;
    }
    .box {
        background: #f3f3f3;
        padding: 40px;
        border-radius: 10px;
        flex: 1;
    }
    .box svg {
        height: 28px;
        width: 28px;
        margin-bottom: 15px;
        opacity: 0.7;
    }
    .box h3 {
        font-size: 35px;
        font-family: "EB Garamond";
        max-width: 70%;
        line-height: 38px;
        margin-bottom: 20px;
    }
    .box p {
        font-size: 16px;
        opacity: 0.7;
        max-width: 70%;
    }
    .features h2 {
        margin-bottom: 60px;
    }
    .features {
        margin-bottom: 120px;
    }
    .timeline {
        text-align: center;
        margin-bottom: 120px;
        margin-top: 120px;
    }
    .timeline h2 {
        margin-bottom: 40px;
    }
    .timeline svg {
        margin: 0 auto;
        margin-top: 5px;
        margin-bottom: 5px;
    }
    .item {
        background: rgb(0, 0, 0, 0.03);
        border: 1px solid rgb(0, 0, 0, 0.1);
        border-radius: 5px;
        padding: 20px 25px;
        font-size: 16px;
        max-width: 500px;
        margin: 0 auto;
        font-weight: 700;
        color: rgb(0, 0, 0, 0.7);
    }
    .build h2 {
        margin-bottom: 60px;
    }
    .grad2 {
        position: absolute;
        left: 0;
        z-index: -1;
    }
    .banner {
        text-align: center;
        margin-bottom: 120px;
    }
    .banner h2 {
        margin-bottom: 30px;
    }
    .section h3 {
        font-weight: 300;
        margin-bottom: 20px;

        font-family: "EB Garamond";
        font-size: 32px;
    }
    .section p {
        opacity: 0.7;
        max-width: 380px;
    }
    .section .left {
        max-width: 50%;
    }
    .build {
        margin-top: 120px;
    }
    .row {
        display: flex;
        gap: 30px;
        margin-bottom: 30px;
    }
    .box {
        background: #fff;
        padding: 40px;
        border-radius: 12px;
        flex: 1;
        transition: transform 0.3s ease;
    }
    .box:hover {
        transform: translateY(-5px);
    }
    .box .icon {
        height: 32px;
        width: 32px;
        margin-bottom: 20px;
        opacity: 0.8;
    }
    .box h3 {
        font-size: 1.4rem;
        font-family: "EB Garamond";
        max-width: 100%;
        line-height: 1.3;
        margin-bottom: 20px;
        font-weight: 600;
    }
    .box p {
        font-size: 1rem;
        opacity: 0.8;
        max-width: 100%;
        line-height: 1.6;
    }
</style>
