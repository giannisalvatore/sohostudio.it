---
const { size = "m", type = "cta" } = Astro.props;

/*
    - text
    - size (s, m, l, xl)
    - type (cta, secondary, disabled)
*/
---

<button class={`${size} ${type}`}><slot /></button>

<style>
    button {
        font-family: "Satoshi";
        background: #212121;
        border: 0;
        color: #fff;
        padding: 12px 17px;
        font-size: 14px;
        font-weight: 700;
        border-radius: 3px;
    }
    .l {
        font-size: 18px;
        padding: 15px 25px;
    }
    .m {
        font-size: 14px;
        padding: 13px 20px;
    }
    .cta {
        background: #684ec5;
    }
    .secondary {
        background: #111;
    }
</style>
