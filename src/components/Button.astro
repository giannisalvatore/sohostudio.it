---
const { text, size = "m", type = "cta" } = Astro.props;

/*
    - text
    - size (s, m, l, xl)
    - type (cta, secondary, disabled)
*/
---

<button class={`${size} ${type}`}>{text}</button>

<style>
    button {
        font-family: "Satoshi";
        background: #212121;
        border: 0;
        color: #fff;
        padding: 12px 17px;
        font-size: 14px;
        font-weight: 700;
    }
    .l {
        font-size: 18px;
        padding: 15px 30px;
    }
    .m {
        font-size: 14px;
        padding: 15px 20px;
    }
</style>
