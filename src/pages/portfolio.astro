---
import Page from "../layouts/Page.astro";
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

import Shampora from "../assets/portfolio/shampora.jpg";
import Podernuovo from "../assets/portfolio/podernuovo.jpg";
import Hoppipolla from "../assets/portfolio/hoppipolla.jpeg";
import Paros from "../assets/portfolio/paros.jpg";
import Copihue from "../assets/portfolio/copihue.jpg";
import Wave from "../assets/portfolio/wave.jpg";
import Hyperlens from "../assets/portfolio/hyperlens.jpg";
import Attivita24 from "../assets/portfolio/attivita24.jpg";
import Giuliana from "../assets/portfolio/giuliana.jpg";

const projects = [
    {
        title: "Attivita24",
        description: "Proprietary Platform",
        image: Attivita24,
        alt: "Attivita24 project",
    },
    {
        title: "Shampora",
        description: "Website · Art direction · UI/UX · Packaging · Photo & Video",
        image: Shampora,
        alt: "Shampora project",
    },
    {
        title: "Podernuovo by Giovanni Bulgari",
        description: "Art Direction · Photography",
        image: Podernuovo,
        alt: "Podernuovo project",
    },
    {
        title: "hoppípolla",
        description: "Graphic Design · Photography",
        image: Hoppipolla,
        alt: "Hoppipolla project",
    },
    {
        title: "Hyperlens",
        description: "Website · Backend · Marketing",
        image: Hyperlens,
        alt: "Hyperlens project",
    },
    {
        title: "Paros Architecture",
        description: "Photography",
        image: Paros,
        alt: "Paros project",
    },
    {
        title: "Copihue Floral Studio",
        description: "Art Direction · Photography · Video",
        image: Copihue,
        alt: "Copihue project",
    },
    {
        title: "Wave Market",
        description: "Graphic Design · Photography",
        image: Wave,
        alt: "Wave project",
    },
    {
        title: "Giuliana Nardi",
        description: "Photography",
        image: Giuliana,
        alt: "Giuliana project",
    },
];
---

<Layout type="light">
    <Page
        topTitle="Portfolio"
        title="I nostri lavori parlano al nostro posto"
        type="light"
        subTitle="Innovazione ed eccellenza sono al centro dei nostri progetti, sempre orientati a risultati concreti per i clienti."
    >
        <div class="portfolio-grid">
            {projects.map((project) => (
                <div class="project-card">
                    <Image src={project.image} alt={project.alt} />
                    <h3>{project.title}</h3>
                    <p>{project.description}</p>
                    <a href="/contatti" class="project-link">Scopri di più</a>
                </div>
            ))}
        </div>
    </Page>
</Layout>

<style>
    .portfolio-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin-top: 40px;
    }
    .project-card {
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        transition: transform 0.3s ease;
    }
    .project-card:hover {
        transform: translateY(-5px);
    }
    .project-card img {
        width: 100%;
        height: 250px;
        object-fit: cover;
    }
    .project-card h3 {
        margin: 20px 20px 10px;
        font-size: 1.4rem;
        font-weight: 600;
    }
    .project-card p {
        margin: 0 20px 20px;
        color: #666;
        font-size: 0.95rem;
        line-height: 1.5;
    }
    .project-link {
        display: block;
        margin: 0 20px 20px;
        color: #000;
        text-decoration: none;
        font-weight: bold;
        border-bottom: 2px solid #000;
        padding-bottom: 2px;
        transition: border-color 0.3s ease;
    }
    .project-link:hover {
        border-color: #666;
    }
    @media screen and (max-width: 768px) {
        .portfolio-grid {
            grid-template-columns: 1fr;
            gap: 15px;
        }
        .project-card h3 {
            font-size: 1.2rem;
        }
        .project-card p {
            font-size: 0.9rem;
        }
        .project-card {
            margin: 0 10px;
        }
    }
</style>
