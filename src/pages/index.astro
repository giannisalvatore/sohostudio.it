---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import HeroImg from "../assets/hero/home.png";
import Logos from "../components/Logos.astro";
import Button from "../components/Button.astro";

import "@/styles/globals.css";
---

<Layout>
    <Header type="dark" btnText="Chiedi un preventivo" />
    <div class="container">
        <div class="hero">
            <h1>Trasformiamo idee in esperienze che fanno la differenza</h1>
            <p class="subtitle">
                Ottieni più risultati in meno tempo: dalla tecnologia che
                semplifica all'estetica che fa la differenza.
            </p>
            <Button size="l">Richiedi un preventivo gratuito</Button>
            <Image src={HeroImg} alt="A sphere of sohostudio." />
        </div>
        <Logos />
        <h2 class="bigTitle">
            Realizziamo prodotti e servizi migliori che portano risultati
        </h2>
        <p class="subBigTitle">
            Il segreto dei prodotti di successo è soltanto uno: risolvono
            problemi reali, e lo fanno meglio della concorrenza.
        </p>
    </div>
</Layout>

<style>
    .container {
        max-width: 1200px;
        margin: 0 auto;
    }
    body {
        background: #111;
    }
    .bigTitle {
        font-size: 75px;
        line-height: 75px;
        max-width: 900px;
        color: #fff;
        font-family: "EB Garamond", serif;
        margin: 0 auto;
        text-align: center;
        margin-top: 30px;
        opacity: 0.8;
    }
    .subBigTitle {
        font-size: 20px;
        text-align: center;
        margin: 0 auto;
        color: #fff;
        opacity: 0.6;
        max-width: 600px;
        font-weight: 400;
        margin-top: 50px;
        margin-bottom: 100px;
    }
    h1 {
        font-family: "EB Garamond", serif;
        font-optical-sizing: auto;
        font-style: normal;
        color: #fff;
        font-weight: 300;
        font-size: 70px;
        max-width: 670px;
        line-height: 70px;
        padding-top: 70px;
        margin-bottom: 30px;
    }
    .subtitle {
        color: #fff;
        opacity: 0.6;
        max-width: 420px;
        font-size: 20px;
        line-height: 30px;
        margin-bottom: 40px;
    }
    .hero img {
        position: absolute;
        top: 0;
        right: 0;
        z-index: -1;
        opacity: 0.7;
    }
</style>
