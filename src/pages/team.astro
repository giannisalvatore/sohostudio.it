---
import Page from "../layouts/Page.astro";
import Layout from "../layouts/Layout.astro";

const teamMembers = [
    {
        name: "Gianni Salvatore",
        role: "Founder & CEO",
        bio: "Visionario digitale con un occhio per l'innovazione. Trasforma idee audaci in realtà tecnologiche, sempre un passo avanti nel mondo del digitale.",
        expertise: ["AI Development", "Software Architecture", "Product Strategy"]
    },
    {
        name: "Viola Carboni",
        role: "Designer & Fotografa",
        bio: "Artista poliedrica che cattura l'essenza della bellezza attraverso l'obiettivo e il design. Crea esperienze visive che parlano al cuore.",
        expertise: ["Brand Identity", "Photography", "Art Direction"]
    },
];
---

<Layout type="light">
    <Page
        btnText="Inizia un progetto"
        topTitle="Chi siamo"
        title="Le persone dietro i progetti"
        type="light"
        subTitle="Un team piccolo ma potente, unito dalla passione per l'innovazione e l'eccellenza."
    >
        <div class="team-container">
            {teamMembers.map((member, index) => (
                <div class="member" data-index={index}>
                    <div class="member-header">
                        <div class="name-role">
                            <h2 class="name">{member.name}</h2>
                            <p class="role">{member.role}</p>
                        </div>
                        <div class="number">0{index + 1}</div>
                    </div>
                    
                    <p class="bio">{member.bio}</p>
                    
                    <div class="expertise">
                        {member.expertise.map((skill) => (
                            <span class="skill-tag">{skill}</span>
                        ))}
                    </div>
                </div>
            ))}
        </div>
        
        <div class="team-stats">
            <div class="stat">
                <div class="stat-number">50+</div>
                <div class="stat-label">Progetti completati</div>
            </div>
            <div class="stat">
                <div class="stat-number">8</div>
                <div class="stat-label">Anni di esperienza</div>
            </div>
            <div class="stat">
                <div class="stat-number">100%</div>
                <div class="stat-label">Clienti soddisfatti</div>
            </div>
        </div>
    </Page>
</Layout>

<style>
    .team-container {
        max-width: 900px;
        margin: 80px auto 120px;
    }
    
    .member {
        margin-bottom: 100px;
        padding-bottom: 60px;
        border-bottom: 1px solid rgba(0, 0, 0, 0.08);
        transition: all 0.4s ease;
    }
    
    .member:last-child {
        border-bottom: none;
        margin-bottom: 0;
    }
    
    .member:hover {
        transform: translateX(10px);
    }
    
    .member-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 25px;
    }
    
    .name {
        font-family: "EB Garamond", serif;
        font-size: 3.5rem;
        font-weight: 500;
        line-height: 1.1;
        margin: 0;
        color: #111;
        letter-spacing: -1px;
    }
    
    .role {
        font-size: 1.1rem;
        color: #666;
        margin: 8px 0 0 0;
        font-weight: 300;
        letter-spacing: 0.5px;
    }
    
    .number {
        font-family: "EB Garamond", serif;
        font-size: 5rem;
        font-weight: 300;
        color: rgba(0, 0, 0, 0.06);
        line-height: 1;
        user-select: none;
    }
    
    .bio {
        font-size: 1.15rem;
        line-height: 1.8;
        color: #444;
        margin: 0 0 30px 0;
        max-width: 650px;
        font-weight: 300;
    }
    
    .expertise {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 25px;
    }
    
    .skill-tag {
        background: #f5f5f5;
        color: #111;
        padding: 8px 18px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 500;
        letter-spacing: 0.3px;
        transition: all 0.3s ease;
    }
    
    .skill-tag:hover {
        background: #111;
        color: #fff;
    }
    
    /* Stats Section */
    .team-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 60px;
        max-width: 900px;
        margin: 100px auto 80px;
        padding-top: 80px;
        border-top: 1px solid rgba(0, 0, 0, 0.08);
    }
    
    .stat {
        text-align: center;
    }
    
    .stat-number {
        font-family: "EB Garamond", serif;
        font-size: 4rem;
        font-weight: 500;
        color: #111;
        line-height: 1;
        margin-bottom: 15px;
    }
    
    .stat-label {
        font-size: 0.95rem;
        color: #666;
        font-weight: 300;
        letter-spacing: 0.3px;
    }
    
    /* Responsive */
    @media screen and (max-width: 768px) {
        .team-container {
            margin: 60px auto 80px;
        }
        
        .member {
            margin-bottom: 70px;
            padding-bottom: 50px;
        }
        
        .member:hover {
            transform: none;
        }
        
        .name {
            font-size: 2.5rem;
        }
        
        .role {
            font-size: 1rem;
        }
        
        .number {
            font-size: 3rem;
            align-self: flex-end;
        }
        
        .bio {
            font-size: 1rem;
            line-height: 1.7;
        }
        
        .team-stats {
            grid-template-columns: 1fr;
            gap: 40px;
            margin: 60px auto 60px;
            padding-top: 60px;
        }
        
        .stat-number {
            font-size: 3rem;
        }
        
        .stat-label {
            font-size: 0.9rem;
        }
    }
    
    @media screen and (max-width: 480px) {
        .name {
            font-size: 2rem;
        }
        
        .number {
            font-size: 2.5rem;
        }
        
        .skill-tag {
            font-size: 0.8rem;
            padding: 6px 14px;
        }
    }
</style>
