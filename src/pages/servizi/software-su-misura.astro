---
import Page from "../../layouts/Page.astro";
import Layout from "../../layouts/Layout.astro";
import BreadcrumbSchema from "@/components/BreadcrumbSchema.astro";

import Button from "@/components/Button.astro";

import { Image } from "astro:assets";
import HeroImg from "../../assets/hero/software.png";
import Triangle from "../../assets/pages/software-su-misura/triangolo.png";
import Square from "../../assets/pages/software-su-misura/rettangolo.png";
import Circle from "../../assets/pages/software-su-misura/cerchio.png";
import Grad from "../../assets/pages/software-su-misura/grad.png";

import Arrow from "../../assets/icons/arrow.svg";
---

<BreadcrumbSchema items={[
    { name: "Home", url: "https://www.sohostudio.it/" },
    { name: "Servizi", url: "https://www.sohostudio.it/servizi/software-su-misura" },
    { name: "Software su Misura", url: "https://www.sohostudio.it/servizi/software-su-misura" }
]} />

<Layout type="dark">
    <Image
        src={HeroImg}
        alt="Sviluppo software su misura - Sohostudio"
        class="grad"
    />
    <Page
        btnText="Parla con un developer"
        topTitle="Software su misura"
        title="Software che lavora per te, non il contrario"
        type="dark"
        subTitle="Creiamo applicazioni su misura per gestire ordini, inventario, CRM o flussi interni, così puoi liberare tempo, ridurre errori e far crescere il business senza intoppi."
    >
        <div class="banner">
            <h2>
                Perchè hai bisogno di un nuovo software?<br />I 3 segnali
                principali
            </h2>
            <div class="keys">
                <div class="key">
                    <Image src={Square} alt="Square" />
                    <p>Perdi ore a correggere errori manuali</p>
                </div>
                <div class="key">
                    <Image src={Triangle} alt="Triangle" />
                    <p>
                        I tuoi dipendenti usano 4 tool diversi per una sola
                        attività.
                    </p>
                </div>
                <div class="key">
                    <Image src={Circle} alt="Circle" />
                    <p>
                        Hai bisogno di flessibilità, ma i software in
                        abbonamento sono rigidi.
                    </p>
                </div>
            </div>
        </div>
        <div class="features">
            <h2>4 vantaggi che solo un software fatto per te può dare</h2>
            <div class="row">
                <div class="box">
                    <h3>Fatto apposta per te, non per gli altri</h3>
                    <p>
                        Niente funzioni inutili che non userai mai: ci
                        concentriamo su ciò che serve davvero alla tua attività,
                        punto per punto.
                    </p>
                </div>
                <div class="box">
                    <h3>Basta perdite di tempo e soldi</h3>
                    <p>
                        Automatizza i task che rallentano il tuo team, dagli
                        ordini alla fatturazione, e riprenditi le ore perse a
                        correggere errori.
                    </p>
                </div>
            </div>
            <div class="row">
                <div class="box">
                    <h3>Cresce con te, senza stravolgere tutto</h3>
                    <p>
                        Se domani raddoppi gli ordini o assumi 10 persone, il
                        software si adatta senza costi nascosti. E funziona con
                        gli strumenti che usi già.
                    </p>
                </div>
                <div class="box">
                    <h3>Non sarai mai solo, avrai supporto continuo</h3>
                    <p>
                        Aggiornamenti, assistenza in 24 ore e nuove funzioni
                        basate sui tuoi feedback. Perché il tuo successo è il
                        nostro.
                    </p>
                </div>
            </div>
        </div>
        <Image
            src={Grad}
            alt="A sphere of sohostudio."
            alt="Grad"
            class="grad2"
        />
        <div class="timeline">
            <h2>Il nostro processo</h2>
            <div class="item">1. Analisi approfondita delle tue esigenze</div>
            <Image src={Arrow} alt="Arrow" />
            <div class="item">2. Progettazione della soluzione ottimale</div>
            <Image src={Arrow} alt="Arrow" />
            <div class="item">3. Sviluppo iterativo con feedback costante</div>
            <Image src={Arrow} alt="Arrow" />
            <div class="item">4. Test approfonditi e ottimizzazione</div>
            <Image src={Arrow} alt="Arrow" />
            <div class="item">
                5. Implementazione e formazione del personale
            </div>
            <Image src={Arrow} alt="Arrow" />
            <div class="item">6. Analisi approfondita delle tue esigenze</div>
            <Image src={Arrow} alt="Arrow" />
            <div class="item">7. Supporto continuo post-rilascio</div>
        </div>

        <div class="build">
            <h2>Realizziamo qualsiasi cosa hai in mente</h2>
            <div class="row">
                <div class="box">
                    <h3>Gestionali aziendali personalizzati</h3>
                </div>
                <div class="box">
                    <h3>Software per l'automazione dei processi</h3>
                </div>
                <div class="box">
                    <h3>Sistemi di gestione del magazzino</h3>
                </div>
            </div>
            <div class="row">
                <div class="box">
                    <h3>Piattaforme di e-commerce su misura</h3>
                </div>
                <div class="box">
                    <h3>Applicazioni web e mobile</h3>
                </div>
                <div class="box">
                    <h3>E molto altro</h3>
                </div>
            </div>
        </div>
    </Page>
</Layout>

<style>
    .grad {
        position: absolute;
        top: 0;
        right: 0;
        z-index: -1;
        opacity: 0.7;
        max-width: 780px;
    }
    .banner {
        margin-top: 40px;
    }
    h2 {
        font-size: 45px;
        line-height: 48px;
        text-align: center;
        font-family: "EB Garamond";
        opacity: 0.8;
    }
    .key img {
        max-width: 48px;
        margin: 0 auto;
        margin-bottom: 15px;
    }
    .keys {
        display: flex;
        justify-content: center;
        align-items: flex-start;

        max-width: 700px;

        margin: 0 auto;

        margin-top: 60px;
        margin-bottom: 140px;
    }
    .key p {
        text-align: center;

        max-width: 200px;
        margin: 0 auto;

        opacity: 0.7;
    }
    .key {
        flex: 1;
        align-self: center;
    }
    .row {
        display: flex;
        gap: 20px;
        margin-bottom: 20px;
    }
    .box {
        background: #181818;
        padding: 40px;
        border-radius: 10px;
        flex: 1;
    }
    .box h3 {
        font-size: 35px;
        font-family: "EB Garamond";
        max-width: 70%;
        line-height: 38px;
        margin-bottom: 70px;
    }
    .box p {
        font-size: 16px;
        opacity: 0.7;
        max-width: 70%;
    }
    .features h2 {
        margin-bottom: 60px;
    }
    .features {
        margin-bottom: 120px;
    }
    .timeline {
        text-align: center;
        margin-bottom: 120px;
    }
    .timeline h2 {
        margin-bottom: 40px;
    }
    .timeline img {
        margin: 0 auto;
        margin-top: 5px;
        margin-bottom: 5px;
    }
    .item {
        background: rgb(255, 255, 255, 0.03);
        border: 1px solid rgb(255, 255, 255, 0.1);
        border-radius: 5px;
        padding: 20px 25px;
        font-size: 16px;
        max-width: 450px;
        margin: 0 auto;
        font-weight: 700;
        color: rgb(255, 255, 255, 0.7);
    }
    .build h2 {
        margin-bottom: 60px;
    }
    .grad2 {
        position: absolute;
        left: 0;
        z-index: -1;
    }
    .banner {
        text-align: center;
        margin-bottom: 120px;
    }
    .banner h2 {
        margin-bottom: 30px;
    }
    @media screen and (max-width: 768px) {
        h2 {
            font-size: 28px;
            line-height: 32px;
        }
        .box h3 {
            font-size: 24px;
            line-height: 28px;
            margin-bottom: 30px;
        }
        .box {
            padding: 20px;
        }
        .keys {
            flex-direction: column;
            gap: 30px;
        }
        .row {
            flex-direction: column;
        }
    }
</style>
