---
import { SEO } from "astro-seo";
import seoData from "../data/seo.json";

const { pathname } = Astro.url;
// Normalizza il pathname rimuovendo trailing slash (eccetto per la home)
const normalizedPath = pathname === '/' ? '/' : pathname.replace(/\/$/, '');
const seo = (seoData as Record<string, any>)[normalizedPath] || seoData.default;

// Genera il canonical URL completo
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
---

<SEO
    title={seo.title}
    description={seo.description}
    canonical={canonicalURL}
    openGraph={seo.openGraph}
    twitter={seo.twitter}
    extend={seo.extend}
/>

<!-- Privacy-friendly analytics by Plausible -->
<script async src="https://analytics.sohostudio.it/js/pa-vLoW0JBIyKnSk0DkWhc7K.js"></script>
<script>
  window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
  plausible.init()
</script>
