---
import Page from "../../layouts/Page.astro";
import Layout from "../../layouts/Layout.astro";

import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import HeroImg from "../../assets/pages/e-commerce/hero.jpg";

import Triangle from "../../assets/pages/software-su-misura/triangolo.png";
import Square from "../../assets/pages/software-su-misura/rettangolo.png";
import Circle from "../../assets/pages/software-su-misura/cerchio.png";
---

<Layout type="light">
    <Image
        src={HeroImg}
        alt="A sphere of sohostudio."
        alt="Grad"
        class="grad"
    />
    <Page
        btnText="Parla con un nostro store expert"
        topTitle="Siti web & E-commerce"
        title="Trasforma visitatori in clienti fedeli"
        type="light"
        subTitle="Siti performanti e e-commerce su misura che aumentano del 67%* il tempo di permanenza e del 45%* le conversioni (*media clienti)"
    >
        <div class="banner">
            <h2>Perchè dovresti sceglierci</h2>
            <div class="keys">
                <div class="key">
                    <Image src={Square} alt="Square" />
                    <h3>Design guidato dai dati</h3>
                    <p>
                        Analizziamo il comportamento degli utenti per progettare
                        interfacce che convertono
                    </p>
                </div>
                <div class="key">
                    <Image src={Triangle} alt="Triangle" />
                    <h3>Tecnologia future-proof</h3>
                    <p>
                        Architetture scalabili con prestazioni ottimizzate e
                        sicurezza certificata
                    </p>
                </div>
                <div class="key">
                    <Image src={Circle} alt="Circle" />
                    <h3>Growth Partnership</h3>
                    <p>
                        Non rilasciamo il progetto e basta: monitoriamo i
                        risultati per 2 mesi gratuitamente
                    </p>
                </div>
            </div>
        </div>
        <h2>
            Rendi semplice il processo di conversione<br />
            qualsiasi sia l’obiettivo<br />
            dalla vendita alla raccolta di e-mail
        </h2>
        <div class="build">
            <div class="row">
                <div class="box">
                    <Icon name="mdi:storefront" class="icon" />
                    <h3>Soluzioni di e-commerce personalizzate</h3>
                    <p>
                        Progettiamo piattaforme uniche e scalabili, integrate
                        con i migliori strumenti per la gestione delle vendite
                        online.
                    </p>
                </div>
                <div class="box">
                    <Icon name="mdi:web" class="icon" />
                    <h3>Landing page ad alte prestazioni</h3>
                    <p>
                        Creiamo pagine ottimizzate per la conversione, perfette
                        per campagne pubblicitarie e funnel di vendita.
                    </p>
                </div>
                <div class="box">
                    <Icon name="mdi:account-circle-outline" class="icon" />
                    <h3>Design orientato all'utente</h3>
                    <p>
                        Ogni progetto è pensato per offrire un’esperienza
                        intuitiva e coinvolgente ai tuoi utenti.
                    </p>
                </div>
            </div>
            <div class="row">
                <div class="box">
                    <Icon name="mdi:magnify" class="icon" />
                    <h3>Ottimizzazione SEO integrata</h3>
                    <p>
                        Le nostre soluzioni sono progettate per essere visibili
                        sui motori di ricerca e migliorare il tuo
                        posizionamento.
                    </p>
                </div>
                <div class="box">
                    <Icon name="mdi:rocket-launch-outline" class="icon" />
                    <h3>Performance al primo posto</h3>
                    <p>
                        Velocità di caricamento e ottimizzazione tecnica
                        garantiscono un'esperienza senza interruzioni.
                    </p>
                </div>
                <div class="box">
                    <Icon name="mdi:chart-line" class="icon" />
                    <h3>Analisi dei dati e miglioramenti</h3>
                    <p>
                        Monitoriamo e analizziamo l'impatto delle tue pagine per
                        garantirti risultati sempre migliori.
                    </p>
                </div>
            </div>
            <div class="row">
                <div class="box">
                    <Icon
                        name="mdi:transit-connection-horizontal"
                        class="icon"
                    />
                    <h3>Integrazione con strumenti di marketing</h3>
                    <p>
                        Colleghiamo le tue pagine con CRM, sistemi di email
                        marketing e altre piattaforme essenziali.
                    </p>
                </div>
                <div class="box">
                    <Icon name="mdi:lifebuoy" class="icon" />
                    <h3>Supporto continuo e manutenzione</h3>
                    <p>
                        Ti accompagniamo anche dopo il lancio, per assicurarti
                        che tutto funzioni al meglio nel tempo.
                    </p>
                </div>
                <div class="box">
                    <Icon name="mdi:lightbulb-outline" class="icon" />
                    <h3>Creatività e strategia</h3>
                    <p>
                        Uniamo design accattivante e strategie di marketing per
                        farti raggiungere i tuoi obiettivi.
                    </p>
                </div>
            </div>
        </div>
    </Page>
</Layout>

<style>
    .grad {
        position: absolute;
        top: 0;
        right: 0;
        z-index: -1;
        opacity: 0.8;
        max-width: 600px;
    }
    .banner {
        margin-top: 40px;
    }
    h2 {
        font-size: 45px;
        line-height: 48px;
        text-align: center;
        font-family: "EB Garamond";
        opacity: 0.8;
    }
    .key img {
        max-width: 48px;
        margin: 0 auto;
        margin-bottom: 15px;
    }
    .keys {
        display: flex;
        justify-content: center;
        align-items: flex-start;

        max-width: 800px;

        margin: 0 auto;

        margin-top: 60px;
        margin-bottom: 140px;
        gap: 20px;
    }
    .key h3 {
        font-weight: 700;
        margin-bottom: 10px;
    }
    .key p {
        text-align: center;

        max-width: 350px;
        margin: 0 auto;

        opacity: 0.7;
    }
    .key {
        flex: 1;
    }
    .row {
        display: flex;
        gap: 20px;
        margin-bottom: 20px;
    }
    .box {
        background: #f3f3f3;
        padding: 40px;
        border-radius: 10px;
        flex: 1;
    }
    .box svg {
        height: 28px;
        width: 28px;
        margin-bottom: 15px;
        opacity: 0.7;
    }
    .box h3 {
        font-size: 35px;
        font-family: "EB Garamond";
        max-width: 70%;
        line-height: 38px;
        margin-bottom: 20px;
    }
    .box p {
        font-size: 16px;
        opacity: 0.7;
        max-width: 70%;
    }
    .features h2 {
        margin-bottom: 60px;
    }
    .features {
        margin-bottom: 120px;
    }
    .timeline {
        text-align: center;
        margin-bottom: 120px;
    }
    .timeline h2 {
        margin-bottom: 40px;
    }
    .timeline img {
        margin: 0 auto;
        margin-top: 5px;
        margin-bottom: 5px;
    }
    .item {
        background: rgb(255, 255, 255, 0.03);
        border: 1px solid rgb(255, 255, 255, 0.1);
        border-radius: 5px;
        padding: 20px 25px;
        font-size: 16px;
        max-width: 450px;
        margin: 0 auto;
        font-weight: 700;
        color: rgb(255, 255, 255, 0.7);
    }
    .build h2 {
        margin-bottom: 60px;
    }
    .grad2 {
        position: absolute;
        left: 0;
        z-index: -1;
    }
    .banner {
        text-align: center;
        margin-bottom: 120px;
    }
    .banner h2 {
        margin-bottom: 30px;
    }
    .section h3 {
        font-weight: 300;
        margin-bottom: 20px;

        font-family: "EB Garamond";
        font-size: 32px;
    }
    .section p {
        opacity: 0.7;
        max-width: 380px;
    }
    .section .left {
        max-width: 50%;
    }
    .build {
        margin-top: 120px;
    }
</style>
