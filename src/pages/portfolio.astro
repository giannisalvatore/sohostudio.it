---
import Page from "../layouts/Page.astro";
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

import Podernuovo from "../assets/portfolio/podernuovo.jpg";
import Hoppipolla from "../assets/portfolio/hoppipolla.jpeg";
import Paros from "../assets/portfolio/paros.jpg";
import Copihue from "../assets/portfolio/copihue.jpg";
import Wave from "../assets/portfolio/wave.jpg";
import Hyperlens from "../assets/portfolio/hyperlens.jpg";
import Attivita24 from "../assets/portfolio/attivita24.jpg";
import Giuliana from "../assets/portfolio/giuliana.jpg";
import Jetugc from "../assets/portfolio/jetugc.jpg";
import Fiscojet from "../assets/portfolio/fiscojet.jpg";

const projects = [
    {
        title: "Attivita24",
        category: "Proprietary Platform",
        description: "Piattaforma per annunci che connette compratori e venditori in tempo reale. Marketplace intuitivo che semplifica la compravendita con sistema di matching intelligente.",
        image: Attivita24,
        alt: "Attivita24 project",
        link: "https://www.attivita24.com",
    },
    {
        title: "JetUGC",
        category: "AI Platform · Marketing",
        description: "Piattaforma AI che genera video UGC autentici per campagne pubblicitarie. Inserisci il link del prodotto e ottieni video pronti per Meta, TikTok e Reels in meno di 5 minuti — zero agenzie, zero attese.",
        image: Jetugc,
        alt: "JetUGC project",
        link: "https://www.jetugc.com",
    },
    {
        title: "FiscoJet",
        category: "SaaS · Fintech",
        description: "Soluzione SaaS che automatizza la fatturazione elettronica italiana integrandosi direttamente con Stripe. Genera, firma digitalmente e invia le fatture all'SDI in automatico a ogni pagamento — zero burocrazia, zero azione manuale.",
        image: Fiscojet,
        alt: "FiscoJet project",
        link: "https://www.fiscojet.com",
    },
    {
        title: "Podernuovo by Giovanni Bulgari",
        category: "Art Direction · Photography",
        description: "Progetto di art direction e fotografia per il brand di lusso di Giovanni Bulgari. Immagini che raccontano l'eccellenza e l'heritage Made in Italy.",
        image: Podernuovo,
        alt: "Podernuovo project",
    },
    {
        title: "hoppípolla",
        category: "Graphic Design · Photography",
        description: "Identità visiva completa e servizio fotografico per brand lifestyle. Design contemporaneo che unisce minimalismo e personalità distintiva.",
        image: Hoppipolla,
        alt: "Hoppipolla project",
    },
    {
        title: "Hyperlens",
        category: "Website · Backend · Marketing",
        description: "Sviluppo full-stack di piattaforma tech con focus sulla user experience. Backend scalabile e strategie di marketing data-driven.",
        image: Hyperlens,
        alt: "Hyperlens project",
    },
    {
        title: "Paros Architecture",
        category: "Photography",
        description: "Portfolio fotografico per studio di architettura contemporanea. Scatti che valorizzano linee, volumi e la relazione tra spazi e luce naturale.",
        image: Paros,
        alt: "Paros project",
    },
    {
        title: "Copihue Floral Studio",
        category: "Art Direction · Photography · Video",
        description: "Progetto visual completo per floral designer boutique. Art direction, fotografia prodotto e video per social media.",
        image: Copihue,
        alt: "Copihue project",
    },
    {
        title: "Wave Market",
        category: "Graphic Design · Photography",
        description: "Brand identity e servizio fotografico per marketplace innovativo. Design system coerente che comunica freschezza e affidabilità.",
        image: Wave,
        alt: "Wave project",
    },
    {
        title: "Giuliana Nardi",
        category: "Photography",
        description: "Portfolio fotografico per artista contemporanea. Immagini che esplorano il confine tra moda, arte e narrazione visiva.",
        image: Giuliana,
        alt: "Giuliana project",
    },
];
---

<Layout type="light">
    <Page
        topTitle="Portfolio"
        title="Progetti che trasformano visioni in realtà"
        type="light"
        subTitle="Una selezione dei nostri lavori più significativi, dove creatività e tecnologia si incontrano."
    >
        <div class="portfolio-accordion">
            {projects.map((project, index) => (
                <div class="accordion-item" data-index={index}>
                    <button class="accordion-header">
                        <div class="header-content">
                            <span class="project-number">{String(index + 1).padStart(2, '0')}</span>
                            <h3 class="project-title">{project.title}</h3>
                        </div>
                        <div class="accordion-arrow">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </div>
                    </button>
                    <div class="accordion-content">
                        <div class="content-inner">
                            <div class="project-info">
                                <p class="project-type">{project.category}</p>
                                <p class="project-description">{project.description}</p>
                                {project.link && (
                                    <a class="project-link" href={project.link} target="_blank" rel="noopener">{project.link.replace('https://www.', '')}</a>
                                )}
                            </div>
                            <div class="project-image">
                                <Image src={project.image} alt={project.alt} loading="lazy" />
                            </div>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </Page>
</Layout>

<style>
    .portfolio-accordion {
        max-width: 1300px;
        margin: 60px auto 80px;
    }
    
    .accordion-item {
        border-bottom: 1px solid rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
    }
    
    .accordion-item:hover {
        border-color: rgba(0, 0, 0, 0.25);
    }
    
    .accordion-header {
        width: 100%;
        background: transparent;
        border: none;
        padding: 30px 0;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: all 0.3s ease;
    }
    
    .header-content {
        display: flex;
        align-items: center;
        gap: 30px;
    }
    
    .project-number {
        font-family: "EB Garamond", serif;
        font-size: 18px;
        color: rgba(0, 0, 0, 0.3);
        font-weight: 300;
        min-width: 40px;
    }
    
    .project-title {
        font-family: "EB Garamond", serif;
        font-size: 32px;
        font-weight: 400;
        color: #111;
        margin: 0;
        text-align: left;
        transition: all 0.3s ease;
        opacity: 0.8;
    }
    
    .accordion-header:hover .project-title {
        opacity: 1;
        transform: translateX(5px);
    }
    
    .accordion-arrow {
        color: #111;
        transition: transform 0.3s ease;
        opacity: 0.5;
    }
    
    .accordion-item.active .accordion-arrow {
        transform: rotate(180deg);
        opacity: 1;
    }
    
    .accordion-content {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.4s ease;
    }
    
    .accordion-item.active .accordion-content {
        max-height: 800px;
    }
    
    .content-inner {
        display: flex;
        gap: 50px;
        padding: 20px 0 40px 70px;
        align-items: flex-start;
    }
    
    .project-info {
        flex: 1.5;
        max-width: 450px;
    }
    
    .project-type {
        color: #111;
        opacity: 0.5;
        font-size: 14px;
        font-weight: 400;
        margin: 0 0 15px 0;
        letter-spacing: 0.5px;
    }
    
    .project-description {
        color: #111;
        opacity: 0.8;
        font-size: 17px;
        line-height: 1.7;
        font-weight: 300;
        margin: 0 0 18px 0;
    }

    .project-link {
        display: inline-block;
        font-size: 13px;
        font-weight: 500;
        color: #111;
        opacity: 0.45;
        text-decoration: none;
        letter-spacing: 0.3px;
        border-bottom: 1px solid rgba(0, 0, 0, 0.2);
        padding-bottom: 1px;
        transition: opacity 0.2s ease;
    }

    .project-link:hover {
        opacity: 0.9;
    }
    
    .project-image {
        flex: 1;
        max-width: 450px;
    }
    
    .project-image img {
        width: 100%;
        border-radius: 8px;
        opacity: 0;
        transform: translateY(20px);
        animation: fadeInUp 0.5s ease forwards;
    }
    
    @keyframes fadeInUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    /* Responsive */
    @media screen and (max-width: 768px) {
        .portfolio-accordion {
            margin: 40px auto 60px;
        }
        
        .accordion-header {
            padding: 20px 0;
        }
        
        .header-content {
            gap: 15px;
        }
        
        .project-number {
            font-size: 14px;
            min-width: 30px;
        }
        
        .project-title {
            font-size: 22px;
        }
        
        .content-inner {
            flex-direction: column;
            gap: 25px;
            padding: 15px 0 30px 0;
        }
        
        .project-info,
        .project-image {
            max-width: 100%;
        }
        
        .project-type {
            font-size: 13px;
        }
        
        .project-description {
            font-size: 15px;
        }
    }
    
    @media screen and (max-width: 480px) {
        .project-title {
            font-size: 18px;
        }
        
        .accordion-item.active .accordion-content {
            max-height: 1000px;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const accordionItems = document.querySelectorAll('.accordion-item');
        
        accordionItems.forEach((item) => {
            const header = item.querySelector('.accordion-header');
            
            header?.addEventListener('click', () => {
                const isActive = item.classList.contains('active');
                
                // Close all accordion items
                accordionItems.forEach((otherItem) => {
                    otherItem.classList.remove('active');
                });
                
                // Open clicked item if it wasn't active
                if (!isActive) {
                    item.classList.add('active');
                }
            });
        });
    });
</script>
