---
import { Image } from "astro:assets";

import Layout from "../layouts/Layout.astro";

import HeroImg from "../assets/hero/home.png";

import Header from "../components/Header.astro";
import Logos from "../components/Logos.astro";
import Button from "../components/Button.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
    <Header type="dark" btnText="Chiedi un preventivo" />
    <div class="container">
        <div class="hero">
            <h1>Trasformiamo idee in esperienze che fanno la differenza</h1>
            <p class="subtitle">
                Ottieni più risultati in meno tempo: dalla tecnologia che
                semplifica all'estetica che fa la differenza.
            </p>
            <Button size="l">Richiedi un preventivo gratuito</Button>
            <Image src={HeroImg} alt="A sphere of sohostudio." />
        </div>
        <Logos />
        <h2 class="bigTitle">
            Realizziamo prodotti e servizi migliori che portano risultati
        </h2>
        <p class="subBigTitle">
            Il segreto dei prodotti di successo è soltanto uno: risolvono
            problemi reali, e lo fanno meglio della concorrenza.
        </p>
        <div class="rowBox">
            <div class="box">
                <h2>Costruiamo il tuo brand</h2>
            </div>
            <div class="box">
                <h2>Dirigiamo le tue creatività</h2>
            </div>
        </div>
        <div class="rowBox">
            <div class="box">
                <h2>
                    Sviluppiamo software e app ad-hoc per le esigenze della tua
                    azienda
                </h2>
            </div>
        </div>
        <div class="rowBox">
            <div class="box">
                <h2>Seguiamo il tuo marketing</h2>
            </div>
            <div class="box">
                <h2>Creiamo funnel di vendita personalizzati</h2>
            </div>
        </div>
        <div class="banner">
            <h2 class="bigTitle">Raccontaci la tua idea pazzesca</h2>
            <Button size="xl">Richiedi un preventivo gratuito</Button>
        </div>
        <Footer type="dark" />
    </div>

    <style>
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }
        body {
            background: #111;
        }
        .bigTitle {
            font-size: 45px;
            line-height: 48px;
            text-align: center;
            font-family: "EB Garamond";
            opacity: 0.8;
            max-width: 600px;

            color: #fff;
            font-family: "EB Garamond", serif;
            margin: 0 auto;
            text-align: center;
            margin-top: 30px;
            opacity: 0.8;
        }
        .subBigTitle {
            font-size: 20px;
            text-align: center;
            margin: 0 auto;
            color: #fff;
            opacity: 0.6;
            max-width: 600px;
            font-weight: 400;
            margin-top: 30px;
            margin-bottom: 100px;
        }
        h1 {
            font-family: "EB Garamond", serif;
            font-optical-sizing: auto;
            font-style: normal;
            color: #fff;
            font-weight: 300;
            font-size: 60px;
            max-width: 670px;
            line-height: 59px;
            padding-top: 90px;
            margin-bottom: 20px;
        }
        h1 * {
            display: inline-block;
        }
        h1 svg {
            line-height: 2px;
        }
        .subtitle {
            color: #fff;
            opacity: 0.6;
            max-width: 340px;
            font-size: 18px;
            line-height: 30px;
            margin-bottom: 40px;
        }
        .hero {
            padding-left: 50px;
        }
        .hero img {
            position: absolute;
            top: 0;
            right: 0;
            z-index: -1;
            opacity: 0.7;
        }
        .rowBox {
            display: flex;
            gap: 25px;
            margin-bottom: 25px;
        }
        .box {
            background: #181818;
            color: #fff;
            font-family: "EB Garamond", serif;
            flex: 1;

            padding: 45px;
            font-size: 40px;
            line-height: 45px;

            border-radius: 10px;

            min-height: 360px;
        }
        .box h2 {
            max-width: 420px;
        }
        .banner {
            margin-top: 120px;
            margin-bottom: 120px;
            text-align: center;
        }
        .banner h2 {
            margin-bottom: 40px;
        }
    </style>
</Layout>
