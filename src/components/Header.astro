---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import logoBlack from "../assets/logo_black.svg";
import logoWhite from "../assets/logo_white.svg";

import NavigationMenu from "./NavigationMenu.jsx";

import MenuIcon from "../assets/menu.svg";

import Grad01 from "../assets/categoryLogos/Grad_01.png";
import Grad02 from "../assets/categoryLogos/Grad_02.png";
import Grad03 from "../assets/categoryLogos/Grad_03.png";
import Grad04 from "../assets/categoryLogos/Grad_04.png";
import Grad05 from "../assets/categoryLogos/Grad_05.png";
import Grad06 from "../assets/categoryLogos/Grad_06.png";
import Grad13 from "../assets/categoryLogos/Grad_13.png";
import Grad10 from "../assets/categoryLogos/Grad_10.png";

const { type } = Astro.props;
const sub = [
    {
        title: "Branding, Creatività & Design",
        href: "/servizi/creativita-branding-design",
        description:
            "Creiamo identità visive uniche e soluzioni creative su misura.",
        logo: Grad13,
    },
    {
        title: "Software su misura",
        href: "/servizi/software-su-misura",
        description:
            "Sviluppiamo software personalizzati per soddisfare le esigenze specifiche.",
        logo: Grad01,
    },
    {
        title: "Intelligenza artificiale",
        href: "/servizi/intelligenza-artificiale",
        description:
            "Integriamo l'intelligenza artificiale per ottimizzare processi e operazioni.",
        logo: Grad02,
    },
    {
        title: "Siti web & E-commerce",
        href: "/servizi/siti-web-e-commerce",
        description:
            "Progettiamo siti web ed e-commerce facili da usare e scalabili.",
        logo: Grad10,
    },
    {
        title: "Applicazioni Mobile",
        href: "/servizi/applicazioni-mobile",
        description:
            "Realizziamo applicazioni mobile ottimizzate per il tuo business.",
        logo: Grad05,
    },
    {
        title: "Marketing",
        href: "/servizi/marketing",
        description:
            "Strategie di marketing digitale per incrementare visibilità e engagement.",
        logo: Grad06,
    },
];
---

<div class={`header ${type} mobile`}>
    <div class="inner">
        <div class="menuContainer" id="menuToggle">
            <Image src={MenuIcon} alt="Menu di navigazione" class="hamburger" />
            <span class="close-icon">×</span>
        </div>
        <div class="first logoContainer">
            <a href="/">
                <Image
                    src={type == "dark" ? logoWhite : logoBlack}
                    alt="sohostudio logo black"
                    class="logo"
                />
            </a>
        </div>
        <div class="menu">
            <div class="item last"><a href="/contatti">Contatti</a></div>
        </div>
    </div>
    <div class="mobile-menu" id="mobileMenu">
        <div class="mobile-menu-inner">
            <a href="/servizi/creativita-branding-design">Branding, Creatività & Design</a>
            <a href="/servizi/software-su-misura">Software su misura</a>
            <a href="/servizi/intelligenza-artificiale">Intelligenza artificiale</a>
            <a href="/servizi/siti-web-e-commerce">Siti web & E-commerce</a>
            <a href="/servizi/applicazioni-mobile">Applicazioni Mobile</a>
            <a href="/servizi/marketing">Marketing</a>
            <a href="/portfolio">Portfolio</a>
            <a href="/mission">Valori</a>
            <a href="/team">Chi siamo</a>
            <a href="/contatti">Contatti</a>
        </div>
    </div>
</div>

<div class={`header ${type} desktop`}>
    <div class="inner">
        <div class="menu">
            <div class="item">
                <NavigationMenu
                    type={type}
                    item={"Servizi"}
                    sub={sub}
                    client:load
                />
            </div>
            <div class="item"><a href="/portfolio">Portfolio</a></div>
            <div class="item"><a href="/mission">Valori</a></div>
            <div class="item"><a href="/team">Chi siamo</a></div>
        </div>
        <div class="first logoContainer">
            <a href="/">
                <Image
                    src={type == "dark" ? logoWhite : logoBlack}
                    alt="sohostudio logo black"
                    class="logo"
                />
            </a>
        </div>
        <div class="menu">
            <div class="item last"><a href="/contatti">Contatti</a></div>
        </div>
    </div>
</div>

<style>
    .desktop {
        display: block;
    }
    .mobile {
        display: none;
    }
    .logoContainer {
        text-align: center;
    }
    .logoContainer a {
        display: inline-block;
    }
    hr {
        opacity: 0.3;
    }
    .first {
        flex: 1;
    }
    .menu {
        flex: 1;
    }
    .last {
        flex: 1;
        text-align: right;
    }
    .mobile-menu {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        background: hsl(var(--background));
        display: none;
        z-index: 1000;
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    .mobile-menu.open {
        display: flex;
        opacity: 1;
        justify-content: center;
        align-items: center;
    }
    .mobile-menu-inner {
        text-align: center;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 15px;
        width: 100%;
        padding: 20px;
    }
    .mobile-menu-inner a {
        display: block;
        font-family: "EB Garamond", serif;
        font-size: 1.4rem;
        color: hsl(var(--foreground));
        text-decoration: none;
        transition: all 0.3s ease;
        opacity: 0.8;
    }
    .mobile-menu-inner a:hover {
        opacity: 1;
        transform: scale(1.05);
    }
    .inner {
        max-width: 1300px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;

        padding-left: 50px;
        padding-right: 50px;
    }
    .header {
        padding: 25px 0;

        position: sticky;
        top: 0;
        z-index: 1001;
    }
    .header.dark {
        background: linear-gradient(180deg, #000, transparent);
    }
    .header.light {
        background: linear-gradient(180deg, #fff, transparent);
    }
    button {
        background: #212121;
        border: 0;
        color: #fff;
        padding: 10px 17px;
    }
    .menu {
        display: flex;
        gap: 18px;
        align-items: center;

        font-size: 14px;

        font-weight: 400;
    }
    .dark {
        color: #fff;
    }
    .light {
        color: #111;
    }
    a {
        text-decoration: none;
    }
    .dark .item a {
        color: #fff;
        cursor: pointer;
    }
    .light .item a {
        color: #111;
    }
    .item {
        margin-top: 3px;
        opacity: 0.6;
        transition: 0.3s;
        cursor: pointer;
    }
    .item:hover,
    .item a:hover {
        opacity: 1;
    }
    .bg-popover {
        background: #111;
        opacity: 1;
    }
    .logoContainer {
        display: flex;
        justify-content: center;
        align-items: center;

        margin-top: -5px;
    }
    @media screen and (max-width: 880px) {
        .header.desktop {
            display: none;
        }
        .header.mobile {
            display: block;
        }
        .inner {
            padding-left: 30px;
            padding-right: 30px;
        }
        .menuContainer{
            padding-left: 0;
        }
    }
    .menuContainer {
        cursor: pointer;
        position: relative;
        width: 40px;
        height: 40px;
        padding: 8px;
        padding-left: 0;
    }
    .hamburger {
        display: block;
        margin-top: 7px;
    }
    .header.light .hamburger {
        filter: brightness(0);
    }
    .header.dark .hamburger {
        filter: brightness(1);
    }
    .close-icon {
        display: none;
        font-size: 1.5rem;
        color: hsl(var(--foreground));
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-weight: 200;
    }
    .header.mobile.menu-open .hamburger {
        display: none;
    }
    .header.mobile.menu-open .close-icon {
        display: block;
    }
    body.no-scroll {
        overflow: hidden;
    }
</style>

<script>
    function initMobileMenu() {
        const menuToggle = document.getElementById('menuToggle');
        const mobileMenu = document.getElementById('mobileMenu');
        const header = document.querySelector('.header.mobile');
        
        if (!menuToggle || !mobileMenu || !header) {
            console.warn('Menu elements not found');
            return;
        }
        
        // Remove existing listeners before adding new ones
        const newMenuToggle = menuToggle.cloneNode(true);
        if (menuToggle.parentNode) {
            menuToggle.parentNode.replaceChild(newMenuToggle, menuToggle);
        }
        
        newMenuToggle.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            const isOpen = mobileMenu.classList.contains('open');
            
            if (isOpen) {
                mobileMenu.classList.remove('open');
                header.classList.remove('menu-open');
                document.body.classList.remove('no-scroll');
            } else {
                mobileMenu.classList.add('open');
                header.classList.add('menu-open');
                document.body.classList.add('no-scroll');
            }
        });
        
        // Close menu when clicking on a link
        const menuLinks = mobileMenu.querySelectorAll('a');
        menuLinks.forEach(link => {
            link.addEventListener('click', function() {
                mobileMenu.classList.remove('open');
                header.classList.remove('menu-open');
                document.body.classList.remove('no-scroll');
            });
        });
        
        // Close menu when clicking outside
        mobileMenu.addEventListener('click', function(event) {
            if (event.target === mobileMenu) {
                mobileMenu.classList.remove('open');
                header.classList.remove('menu-open');
                document.body.classList.remove('no-scroll');
            }
        });
    }
    
    // Initialize on load
    document.addEventListener('DOMContentLoaded', initMobileMenu);
    
    // Re-initialize after Astro page transitions
    document.addEventListener('astro:page-load', initMobileMenu);
</script>
