---
import Header from "../components/Header.astro";
import Button from "@/components/Button.astro";
import Logos from "@/components/Logos.astro";
import Footer from "@/components/Footer.astro";
const { topTitle, title, subTitle, type, btnText } = Astro.props;
import "@/styles/globals.css";
---

<Header type={type} btnText={btnText} />
<div class={`layout ${type}`}>
    <div class="hero">
        <h2 class="topTitle">{topTitle}</h2>
        <h1 class="title">{title}</h1>
        <p class="subTitle">{subTitle}</p>
        <div class="btnContainer">
            {btnText && <a href="/contatti"><Button size="l">{btnText}</Button></a>}
        </div>
        <Logos />
    </div>
    <slot />
    <Footer type={type} />
</div>

<style>
    .layout {
        max-width: 1300px;
        margin: 0 auto;

        padding-left: 50px;
        padding-right: 50px;
    }
    .dark {
        color: #fff;
    }
    .light {
        color: #111;
    }
    h1 {
        font-family: "EB Garamond", serif;
        font-size: 70px;
        line-height: 75px;
        max-width: 590px;
        text-align: center;
        margin: 0 auto;
        letter-spacing: -1px;
        opacity: 0.9;
    }
    .topTitle {
        text-align: center;
        opacity: 0.8;
        font-weight: 700;
        margin-top: 70px;
        margin-bottom: 20px;
        font-size: 18px;
    }
    .subTitle {
        max-width: 460px;
        margin: 0 auto;
        text-align: center;
        font-size: 18px;
        line-height: 28px;
        opacity: 0.7;
        margin-top: 30px;
    }
    .btnContainer {
        text-align: center;
        margin-top: 30px;
    }
    @media screen and (max-width: 768px) {
        .layout {
            padding-left: 20px;
            padding-right: 20px;
        }
        h1 {
            font-size: 32px;
            line-height: 36px;
            max-width: 100%;
        }
        .topTitle {
            font-size: 14px;
            margin-top: 50px;
        }
        .subTitle {
            font-size: 16px;
            line-height: 24px;
            max-width: 100%;
        }
    }
</style>
