---
const { size = "m", type = "cta" } = Astro.props;

/*
    - text
    - size (s, m, l, xl)
    - type (cta, secondary, disabled)
*/
---

<button class={`${size} ${type}`}><slot /></button>

<style>
    button {
        font-family: "Satoshi";
        background: #000;
        border: 0;
        color: #fff;
        padding: 12px 17px;
        font-size: 14px;
        font-weight: 700;
        border-radius: 3px;
        transition: background 0.3s ease;
    }
    button:hover {
        background: #333;
    }
    .xl {
        font-size: 26px;
        padding: 22px 42px;
    }
    .l {
        font-size: 18px;
        padding: 15px 25px;
    }
    .m {
        font-size: 14px;
        padding: 13px 20px;
    }
    .cta {
        background: #000;
    }
    .secondary {
        background: #000;
    }
    @media screen and (max-width:576px) {
        .cta{
            font-size: 14px;
            padding: 12px 18px;
        }
    }
</style>
