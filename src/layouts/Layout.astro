---
const { type } = Astro.props;
import "@/styles/globals.css";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta
            name="description"
            content="Agenzia creativa e di sviluppo a 360°, curiamo il tuo brand e le tue applicazioni"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <meta name="generator" content={Astro.generator} />
        <title>sohostudio | Agenzia creativa e di sviluppo</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&display=swap"
            rel="stylesheet"
        />
    </head>
    <body class={type}>
        <div class="layout">
            <slot />
        </div>
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
    }
    @font-face {
        font-family: "Satoshi";
        src: url("/src/assets/fonts/Satoshi/Satoshi-Bold.woff2") format("woff2");
        font-weight: 700;
        font-style: normal;
    }
    @font-face {
        font-family: "Satoshi";
        src: url("/src/assets/fonts/Satoshi/Satoshi-Medium.woff2")
            format("woff2");
        font-weight: 400;
        font-style: normal;
    }
    @font-face {
        font-family: "Satoshi";
        src: url("/src/assets/fonts/Satoshi/Satoshi-Regular.woff2")
            format("woff2");
        font-weight: 300;
        font-style: normal;
    }
    body {
        font-family: "Satoshi", sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }
    * {
        font-family: "Satoshi", sans-serif;
    }
    .dark {
        background: #111;
        color: #fff;
    }
    .light {
        background: #fff;
        color: #111;
    }
</style>
